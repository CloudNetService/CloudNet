{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  labels: [
    't: dependencies',
  ],
  reviewers: [
    '0utplay',
    'derklaro',
  ],
  packageRules: [
    {
      matchManagers: [
        'github-actions',
      ],
      groupName: 'github actions',
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      matchPackageNames: [
        '*',
        '!gradle',
      ],
      groupName: 'all dependencies with patch changes',
    },
    {
      matchPackageNames: [
        'net.kyori:adventure-api',
        'net.kyori:adventure-text-serializer-gson',
        'net.kyori:adventure-text-serializer-legacy',
      ],
      groupName: 'adventure monorepo',
    },
    {
      description: 'Correct Guava version handling',
      matchPackageNames: [
        'com.google.guava:guava',
      ],
      versioning: 'regex:^(?<major>\\d+)(\\.(?<minor>\\d+))?(\\.(?<patch>\\d+))?(-(?<compatibility>.*))?$',
    },
    {
      description: "Dependencies whose updates shouldn't be done automatically",
      matchPackageNames: [
        'azul/zulu-openjdk',
        'io.netty:**',
        'com.h2database:h2',
        'cpw.mods:modlauncher',
        'org.spongepowered:spongeapi',
        'io.github.juliarn:npc-lib-**',
        'net.minestom:minestom-snapshots',
        'dev.waterdog.waterdogpe:waterdog',
        'org.incendo:cloud-processors-confirmation',
      ],
      enabled: false,
    },
  ],
  prHourlyLimit: 10,
  rebaseWhen: 'conflicted',
  rebaseLabel: 's: rebase',
  stopUpdatingLabel: 's: stop updates',
  commitMessagePrefix: 'chore: ',
  commitMessageAction: 'update',
}
